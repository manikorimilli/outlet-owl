# Copy to .env (ignored by git) and adjust. `make dev` reads .env as shell
# (and `make migrate` reads DATABASE_URL from it), so quote a value that holds
# a space. Local demo values only; never put real secrets in this file.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/outlet_owl?sslmode=disable
PORT=8080
LOG_LEVEL=info
# Signs the session cookie (ADR-0007). Required, at least 32 bytes; the server
# refuses to start without it. Generate one: openssl rand -hex 32
# Changing it signs everyone out.
JWT_SECRET=
# Accounts loaded at start (phase 1 server LLD, section 3); ignored by git.
USERS_FILE=users.json
# The one brand per installation (Q-001), shown after sign-in. BRAND_NAME is
# required; BRAND_TIMEZONE is an IANA zone that bounds the Monday to Sunday weeks.
BRAND_NAME="Neem Tree Kitchens"
BRAND_TIMEZONE=Asia/Kolkata
# Model gateway (phase 2 LLD section 7). replay answers only from saved
# recordings and spends nothing; live and record call OpenRouter and need the
# key. Set record only on purpose: it spends real budget. Never in CI.
MODEL_GATEWAY_MODE=replay
OPENROUTER_API_KEY=
MODEL_RECORDINGS_DIR=testdata/recordings
# The tagging worker (phase 3 LLD section 9): false keeps it paused, so
# imported reviews stay untagged and no tagging call is made.
TAGGING_ENABLED=true
# Added with their stories, not used yet:
# SMTP_ADDR=localhost:1025          (digest, US-01-009)
# Host ports for docker compose; change them when another service already
# listens there, and keep DATABASE_URL's port in step with POSTGRES_PORT.
POSTGRES_PORT=5432
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
