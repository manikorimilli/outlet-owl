# Go build output and test artefacts
/bin/
*.test
coverage.out

# Web (web/)
web/node_modules/
web/dist/
web/coverage/
*.tsbuildinfo

# Local configuration and secrets: copy .env.example to .env
.env
.env.*
!.env.example
# Accounts with bcrypt hashes, loaded at start (USERS_FILE); copy
# users.example.json and fill in hashes from make hash-password.
/users.json

# Editors and OS
.DS_Store
.idea/
.vscode/

# Bearing: per-machine session state, and the raw answer files the PRD step
# already applied to docs/product/questions.md. Shared Bearing files (for
# example .bearing/company.json) stay tracked.
.bearing/state/
.bearing/answers-*.json
.scratch/
deliverables/
.claude/settings.local.json

# Screenshots generated from the screen designs by evidence.py (rebuildable)
docs/design/screens/app/shots/

# 0-byte placeholders the Claude Code sandbox holds while a command runs
/.bashrc
/.bash_profile
/.zshrc
/.zprofile
/.profile
/.ripgreprc
/.gitconfig

# The tone-check scoring sheet (make tone-check) holds review text: keep it local.
tone-check.md
